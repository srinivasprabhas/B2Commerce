# Copy to apps/<app>/.env.local for local dev, or add in each Vercel project's
# Settings → Environment Variables.

# ---- apps/storefront & apps/admin ----
# Public URL of the app. Optional on Vercel (falls back to the Vercel URL);
# set it once you attach a custom domain, e.g. https://b2commerce.com / https://admin.b2commerce.com
NEXT_PUBLIC_SITE_URL=
# Base URL of apps/server (not used yet — the server isn't built)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- apps/server ----
# PORT=4000
# DATABASE_URL=
# JWT_SECRET=
